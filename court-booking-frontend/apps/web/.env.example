# Khelo web app environment. Copy to .env.local for local dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Optional site content. UNSET MEANS THE THING IS HIDDEN (never a placeholder). ---
# These are read on the server at request time, so on the instance they go in .env.web and need only a restart, not a rebuild.
# Support WhatsApp number (digits, optional +). Shows the WhatsApp card on /contact and powers the contact form's wa.me link.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Support email. Shows the email card on /contact and powers the contact form's mailto link.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Support hours text, e.g. "Mon to Sat, 10am to 8pm". Shows the hours line on /contact.
NEXT_PUBLIC_SUPPORT_HOURS=
# Owner plan pricing sentence(s). Shows the pricing block on /for-owners.
NEXT_PUBLIC_OWNER_PRICING_TEXT=
# Public origin (no trailing slash), e.g. https://khelo.example. Used for sitemap.xml, robots.txt, canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=
