# App
APP_NAME="Court Booking API"
DEBUG=true
API_V1_PREFIX=/api/v1
# Wildcard is fine while DEBUG=true (local dev only) -- main.py refuses to
# boot with ALLOWED_ORIGINS=["*"] once DEBUG=false. Replace this with the
# real deployed frontend origin(s) before the pilot goes live, e.g.
# ALLOWED_ORIGINS=["https://app.yourpilotdomain.com"]. Local dev origins
# for this repo's two frontends: http://localhost:8081 (Expo web),
# http://localhost:3100 (Next.js web).
ALLOWED_ORIGINS=["http://localhost:8081","http://localhost:3100"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/court_booking

# Auth
SESSION_TOKEN_SECRET=change-me-to-a-long-random-string
# Must be a DISTINCT value from SESSION_TOKEN_SECRET, generated separately, e.g.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts venues.bank_details at rest. Unset + DEBUG=false makes the app
# raise at first use rather than silently falling back to SESSION_TOKEN_SECRET
# -- see app/utils/encryption.py.
BANK_DETAILS_ENCRYPTION_KEY=
# Section 26: sessions last 8h and are kept alive by the clients' proactive POST /auth/refresh.
# (The old SESSION_TOKEN_EXPIRE_DAYS is gone; a stale copy in your .env is silently ignored.)
SESSION_TOKEN_EXPIRE_HOURS=8
# A verified phone is trusted this long (from users.phone_verified_at); after that, password
# login is refused with PHONE_REVERIFICATION_REQUIRED until the user passes an OTP again.
PHONE_VERIFICATION_TRUST_DAYS=365
# Failed password logins per phone per window before 429 LOGIN_RATE_LIMITED.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
# Local-dev only: set to e.g. 111111 in your own .env to skip WhatsApp/brute-forcing
# during manual testing (only takes effect while DEBUG=true). Leave blank here and
# never set it in any shared/staging .env.
DEV_FIXED_OTP=

# AWS -- for local dev, run `docker compose up -d localstack` and point this at it:
#   AWS_ACCESS_KEY_ID=test / AWS_SECRET_ACCESS_KEY=test / AWS_ENDPOINT_URL=http://localhost:4566
# then create the two buckets once (LocalStack starts empty, no persistence across
# `docker compose down -v`): aws --endpoint-url http://localhost:4566 s3 mb s3://court-booking-public
# (and court-booking-private). Without this, payment-proof upload 500s with NoSuchBucket.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
S3_BUCKET_PUBLIC=court-booking-public
S3_BUCKET_PRIVATE=court-booking-private
S3_KMS_KEY_ID=
CLOUDFRONT_DOMAIN=

# WhatsApp
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me
# From the Meta app dashboard (App Settings > Basic > App Secret) -- required
# so POST /webhooks/whatsapp can verify the X-Hub-Signature-256 HMAC on every
# inbound request. Unset + DEBUG=true skips verification for local dev
# (logged loudly); unset + DEBUG=false rejects every webhook outright.
WHATSAPP_APP_SECRET=

# AI Provider (Section 21) -- choose one: claude | gemini | openai
AI_PROVIDER=claude
AI_VISION_PROVIDER=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_HAIKU_MODEL=claude-haiku-4-20250514
CLAUDE_SONNET_MODEL=claude-sonnet-4-20250514

# Gemini -- gemini-2.0-flash/-pro and gemini-2.5-flash/-pro are confirmed
# dead ("no longer available to new users") as of 2026-09-08; these are
# the last live-verified defaults -- re-verify with a real key before
# trusting them, Google renames/deprecates these fast. GEMINI_PRO_MODEL
# (vision/OCR) was switched from gemini-pro-latest to gemini-3.5-flash-lite
# on 2026-09-19 after the former hit 429 quota errors on every vision call
# tried against this project's key/plan -- see config.py's comment.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-3.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_FULL_MODEL=gpt-4o

# FCM (push notifications). The Firebase service-account JSON (Firebase console ->
# Project settings -> Service accounts -> Generate new private key), either pasted raw
# or base64-encoded (`base64 -w0 key.json`; use base64 in production/SSM -- no quoting
# trouble). Blank = push is skipped, everything else keeps working.
FCM_SERVICE_ACCOUNT_KEY=

# APNs (iOS push, sent straight to Apple). Apple Developer -> Certificates, Identifiers &
# Profiles -> Keys -> "+" -> Apple Push Notifications service (APNs) -> download the .p8
# (Apple lets you download it once). APNS_KEY = the .p8 text, raw or base64. Blank = iOS push skipped.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.maidan.app
# true only for development-client builds; ad-hoc/TestFlight/App Store builds use production.
APNS_USE_SANDBOX=false

# Sentry
SENTRY_DSN=
